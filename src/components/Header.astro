---
/**
 * 页头：站点名 + 导航 + 主题切换。
 */
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE, NAV_LINKS } from '../consts';

const currentPath = Astro.url.pathname;

/** 判断导航项是否为当前页（首页需精确匹配，其余按前缀匹配） */
function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="flex flex-wrap items-center justify-between gap-y-3 border-b border-zinc-200 py-5 dark:border-zinc-800">
  <a href="/" class="text-lg font-semibold tracking-tight hover:text-zinc-600 dark:hover:text-zinc-300">
    {SITE_TITLE}
  </a>

  <div class="flex items-center gap-4">
    <nav aria-label="主导航">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition-colors hover:text-zinc-900 dark:hover:text-zinc-100',
                  isActive(link.href)
                    ? 'font-medium text-zinc-900 dark:text-zinc-100'
                    : 'text-zinc-500 dark:text-zinc-400',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>
