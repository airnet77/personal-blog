---
/**
 * 标签列表，渲染为可点击的圆角标签。
 */
interface Props {
  tags: string[];
  size?: 'sm' | 'md';
}

const { tags, size = 'sm' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${encodeURIComponent(tag)}/`}
            class:list={[
              'inline-block rounded-full border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:text-zinc-100',
              size === 'sm' ? 'px-2.5 py-0.5 text-xs' : 'px-3 py-1 text-sm',
            ]}
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
