---
/**
 * 文章列表项。
 * 只接收 post 数据，不自己取数据（AGENTS.md R4）。
 */
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="border-b border-zinc-200 py-6 first:pt-0 dark:border-zinc-800">
  <a href={href} class="group block">
    <h2
      class="text-xl font-semibold tracking-tight transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300"
    >
      {title}
    </h2>
    <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
  </a>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-500 dark:text-zinc-500">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-x-2 gap-y-1">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-200"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
