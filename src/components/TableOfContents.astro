---
/**
 * 文章目录。
 * 接收 render() 返回的 headings（自带顺序与锚点 id），只做展示。
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// 只列到 h3，再深会让目录过长
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-label="文章目录" class="text-sm">
      <ul class="space-y-1.5">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
