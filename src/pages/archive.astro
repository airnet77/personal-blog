---
/**
 * 归档：按年份分组，倒序列出全部文章。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByYear, formatDate } from '../lib/posts';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<BaseLayout title="归档" description="按时间归档的全部文章">
  <header class="pb-8">
    <h1 class="text-2xl font-bold tracking-tight">归档</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">共 {posts.length} 篇</p>
  </header>

  {
    years.map(({ year, posts: list }) => (
      <section class="mb-10">
        <h2 class="mb-3 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          {year}
          <span class="ml-2 text-sm font-normal text-zinc-400 dark:text-zinc-500">{list.length} 篇</span>
        </h2>
        <ul class="space-y-2">
          {list.map((post) => (
            <li class="flex items-baseline gap-3">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500"
              >
                {formatDate(post.data.pubDate).slice(5)}
              </time>
              <a
                href={`/blog/${post.id}/`}
                class="text-zinc-700 transition-colors hover:text-zinc-900 hover:underline dark:text-zinc-300 dark:hover:text-zinc-100"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    posts.length === 0 && <p class="py-6 text-zinc-500 dark:text-zinc-400">还没有文章。</p>
  }
</BaseLayout>
