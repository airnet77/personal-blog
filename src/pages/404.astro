---
/**
 * 404 页面。Cloudflare Pages 会自动使用根目录的 404.html。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在">
  <section class="py-16 text-center">
    <p class="font-mono text-5xl font-bold text-zinc-300 dark:text-zinc-700">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">页面不存在</h1>
    <p class="mt-3 text-zinc-500 dark:text-zinc-400">
      你访问的地址可能已经移动，或者从来没有存在过。
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md border border-zinc-200 px-4 py-2 text-sm transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:hover:bg-zinc-800"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
